{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rie.un.example/schemas/source-registry.json",
  "title": "Source registry — per jurisdiction",
  "type": "object",
  "additionalProperties": false,
  "required": ["jurisdiction", "sources"],
  "properties": {
    "jurisdiction": { "type": "string", "minLength": 2 },
    "language": { "type": "string", "default": "en" },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "document_type", "authority_tier"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "source_url": { "type": ["string", "null"] },
          "local_path": { "type": ["string", "null"] },
          "document_type": {
            "enum": ["statute", "amendment", "regulation", "guideline", "treaty", "notice", "other"]
          },
          "authority_tier": {
            "enum": ["tier_1_statute", "tier_2_regulation", "tier_3_guideline", "tier_4_informal"]
          },
          "effective_date": { "type": ["string", "null"], "format": "date" },
          "sha256_hash": { "type": ["string", "null"] },
          "language": { "type": "string" }
        }
      }
    },
    "discovery": {
      "type": "object",
      "description": "Optional discovery-crawler config (Phase 2). Additive — IngestService ignores this block; only `rie-discovery` reads it.",
      "additionalProperties": false,
      "required": ["seed_urls"],
      "properties": {
        "seed_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "crawl_patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "link_regexes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "mime_allow": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "depth_limit": { "type": "integer", "minimum": 0, "default": 2 },
        "crawl_delay_seconds": { "type": "number", "minimum": 0, "default": 1.0 },
        "max_pages": { "type": "integer", "minimum": 1, "default": 200 }
      }
    }
  }
}
