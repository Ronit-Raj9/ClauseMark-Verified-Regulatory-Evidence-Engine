# ──────────────────────────────────────────────────────────────────────────
# Regulatory Intelligence Engine — environment template
#
# Profile defaults tuned for **4 GB VRAM** (or CPU-only). Bigger model
# alternatives commented inline for ≥16 GB VRAM rigs.
# Copy to `.env` and edit as needed.
# ──────────────────────────────────────────────────────────────────────────

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rie
POSTGRES_USER=rie
POSTGRES_PASSWORD=rie_dev_password
DATABASE_URL=postgresql+psycopg://rie:rie_dev_password@localhost:5433/rie
DATABASE_URL_SYNC=postgresql+psycopg://rie:rie_dev_password@localhost:5433/rie

# ── Qdrant ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=rie_clauses

# ── LLM serving ──
# Backend: ollama | vllm
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Classifier model — picked from a fresh enum each call (constrained decoding).
# 4 GB VRAM default ↓ (≈2 GB resident, leaves headroom for verifier swap-in)
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# 4 GB tight fallback (≈1 GB resident — works on CPU too)
# OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
# 4 GB alt (Llama family, ≈2.5 GB)
# OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# ≥16 GB VRAM upgrade
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Verifier 2nd-LLM — MUST be different family from classifier (§6.5).
# 4 GB VRAM default ↓ (≈2.5 GB; never co-resident with classifier — Ollama swaps)
OLLAMA_VERIFIER_MODEL=phi3:3.8b-mini-instruct-4k-q4_K_M
# 4 GB tighter (≈1.5 GB)
# OLLAMA_VERIFIER_MODEL=gemma2:2b-instruct-q4_K_M
# ≥16 GB VRAM upgrade
# OLLAMA_VERIFIER_MODEL=mistral:7b-instruct-q4_K_M

# VLM-OCR for scanned PDFs — heavy, skip on 4 GB unless absolutely needed.
# OLLAMA_VLM_MODEL=llama3.2-vision

# Ollama memory hygiene on small VRAM ↓
# Unload idle model fast so classifier + verifier can swap without OOM.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
# Force CPU offload for layers that don't fit (slower but safe).
# OLLAMA_NUM_GPU=20

# vLLM alternative (needs CUDA — 4 GB VRAM is below vLLM's practical floor).
# Use Ollama instead unless on ≥16 GB GPU.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_API_KEY=local-dev

# ── Embeddings + rerank + NLI ──
# Architecture default: BGE-M3 dense + Qdrant BM25 sparse + bge-reranker-v2-m3.
# All CPU-friendly. BGE-M3 ≈600 MB CPU; reranker ≈100 MB CPU; NLI ≈400 MB CPU.
# No VRAM required.
EMBEDDING_MODEL=BAAI/bge-m3
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Disable real NLI if CPU latency is unacceptable — second-LLM still runs.
# RIE_NLI_BACKEND=fake

# ── Tracing (optional, no API key needed unless you want Langfuse) ──
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Pipeline flags ──
# Set to 1 to bypass ALL LLM calls + use deterministic fakes. Demo-safe.
RIE_FORCE_FAKES=0
# Set to 1 to enable LangGraph Postgres checkpointer (durable HITL resume).
RIE_USE_POSTGRES_CHECKPOINTER=0
# Classifier self-consistency samples per clause. §6.5 default = 3.
# On 4 GB VRAM with small models, set to 1 to cut latency 3× (loses self-consistency gate).
RIE_N_SAMPLES=1

# ── Phase 2 flags (opt-in — MVP behaviour when all zero) ──
# Set to 1 to run the additive 5th verification gate (kg_grounding) alongside the canonical 4.
RIE_KG_GATE_ENABLED=0
# Set to 1 to attach corpus-completeness signals and downgrade NO_EVIDENCE when the manifest is incomplete.
RIE_CORPUS_COMPLETENESS_ENABLED=0
# Classifier multilingual path — detect clause language + per-language keyword lists in prompts.
RIE_MULTILINGUAL_ENABLED=1

# ── App ──
ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
PILLARS_DIR=./pillars
GOLD_DIR=./gold
SOURCES_DIR=./sources
API_HOST=0.0.0.0
API_PORT=8080
STREAMLIT_PORT=8501
UI_WEB_PORT=5173
RIE_API_URL=http://localhost:8080
